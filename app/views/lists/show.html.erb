<%
  header_style = "background-color: #343a40; padding: 30px; min-height: 75vh;"
  if @list.photo.attached?
    cloudinary_path = cl_image_path(@list.photo.key, height: 300, crop: :fill)

    header_style = "background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('#{cloudinary_path}'); padding: 30px; background-size: cover; background-position: center; background-repeat: no-repeat; min-height: 75vh;" # Removed border-radius for full width look
  end
%>


<div style="<%= header_style %>">
    <div class="row justify-content-center align-content-center">
      <div class="col-lg-10">
        <h1 class="text-center my-4 text-light"><%= @list.name %></h1>
      </div>
    </div>
</div>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="d-flex justify-content-end mt-3 mb-3">
        <%= link_to "Add a movie", new_list_bookmark_path(@list.id), class: "btn btn-success" %>
      </div>
      <ul class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 list-unstyled">
        <% @movies.each do |movie| %>
          <li class="col">
            <div class='card h-100 shadow-sm'>
              <img
                src="<%= movie.poster_url %>"
                alt="<%= movie.title %> Poster"
                class="card-img-top"
              >
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                  <h5 class="card-title mb-0 me-auto">
                    <%= movie.title %>
                  </h5>
                </div>
                <div>
                  <p class="card-text text-muted mt-2">
                    <i class="fa-solid fa-tag"></i> <%= movie.overview %>
                  </p>
                  <p class="card-text">
                    <i class="bi bi-geo-alt-fill me-1"></i> <%= movie.rating.round(1) %>
                  </p>
                </div>
                <div class="d-flex justify-content-between">
                  <p>
                    <i class="fa-solid fa-comment"></i>
                    <%= movie.bookmarks.where(list: @list).map { |bookmark| bookmark.comment }.join %>
                  </p>
                  <%= link_to 'Delete', bookmark_path(Bookmark.find_by(movie: movie, list: @list)), class: "btn btn-danger", data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>

    </div>
  </div>
</div>
