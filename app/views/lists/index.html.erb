

<div class="w-100 text-center">
  <div class="row d-flex align-items-center mb-5 pt-5 logo">
    <div class="mt-5 p-3 logo-text">
      <h1>Add Movies to your lists</h1>
    </div>

  </div>
  <div class="container">
    <div class="container d-flex justify-content-between p-3 mb-3">
      <h3>My Lists</h3>
      <%= link_to 'Create a Movie List', new_list_path, class: "btn btn-primary" %>
    </div>
    <ul class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 list-unstyled">
      <% @lists.each do |list| %>
      <%= link_to list_path(list.id), class: "text-decoration-none text-dark" do %>
          <div class="card p-3" style>
            <div class="col card-title">
              <p><%= list.name %></p>
            </div>
          </div>
        <% end  %>
      <% end %>
    </ul>
  </div>
</div>
