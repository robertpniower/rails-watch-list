<div class="container">
  <div class="card m-auto shadow-sm" style="width: 48rem;">
    <div class="card-body">
      <div class="row mb-2">
        <h2 class="card-title">
        Add a new List
        </h2>
      </div>

        <%= simple_form_for(@list) do |f| %>
          <%= f.input :name %>
          <%= f.input :photo, as: :file %>
          <%= f.submit class: "btn btn-primary" %>
        <% end %>

    </div>
  </div>

</div>
